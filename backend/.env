# ─── Server ───
APP_NAME=HealthcarePlatform
DEBUG=true
SECRET_KEY=CHANGE_ME_IN_PRODUCTION_use_openssl_rand_hex_64
ALLOWED_ORIGINS='["http://localhost:5173", "http://localhost:3000"]'

# ─── Database ───
DATABASE_URL=postgresql+asyncpg://healthcare:healthcare@localhost:5432/healthcare_db

# ─── Redis ───
REDIS_URL=redis://localhost:6379/0

# ─── JWT ───
JWT_SECRET_KEY=CHANGE_ME_jwt_secret_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── S3 / MinIO ───
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=healthcare-documents
S3_REGION=us-east-1

# ─── AI / Vision-Language Model ───
# Set one or both:
# GOOGLE_API_KEY=your-gemini-key
# ANTHROPIC_API_KEY=your-anthropic-key

# ─── Confidence threshold ───
CONFIDENCE_THRESHOLD=0.80
